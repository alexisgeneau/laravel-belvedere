{
    "name": "alexisgeneau/laravel-belvedere",
    "description": "Horizon-style queue dashboard for Laravel's database queue driver.",
    "keywords": [
        "laravel",
        "queue",
        "jobs",
        "dashboard",
        "monitoring",
        "database"
    ],
    "homepage": "https://github.com/alexisgeneau/laravel-belvedere",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Alexis Geneau",
            "email": "contact@cote-dev.fr"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/bus": "^12.0|^13.0",
        "illuminate/cache": "^12.0|^13.0",
        "illuminate/console": "^12.0|^13.0",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/database": "^12.0|^13.0",
        "illuminate/events": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/notifications": "^12.0|^13.0",
        "illuminate/queue": "^12.0|^13.0",
        "illuminate/routing": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "spatie/laravel-package-tools": "^1.16"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18",
        "laravel/slack-notification-channel": "^3.0|^4.0",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0"
    },
    "suggest": {
        "laravel/slack-notification-channel": "Required to send Belvedere alerts to Slack (^3.0)."
    },
    "autoload": {
        "psr-4": {
            "Belvedere\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Belvedere\\Tests\\": "tests/",
            "Workbench\\Database\\Seeders\\": "workbench/database/seeders/",
            "Workbench\\App\\": "workbench/app/"
        }
    },
    "scripts": {
        "test": "pest",
        "lint": "pint",
        "analyse": "phpstan analyse --memory-limit=1G",
        "build": "@php vendor/bin/testbench workbench:build --ansi",
        "serve": [
            "@build",
            "@php vendor/bin/testbench serve --ansi"
        ],
        "bench": [
            "@php workbench/bench.php --baseline",
            "@php workbench/bench.php"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "Belvedere\\BelvedereServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
